# --- Supabase (Project Settings → API Keys) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# La clave SECRETA (sb_secret_... o la service_role). Solo va acá, nunca en el frontend ni en GitHub.
SUPABASE_SERVICE_KEY=TU_CLAVE_SECRETA
PORT=3001

# --- Opcionales (si no los ponés, se usan estos valores) ---
# FRONTEND_URL=http://localhost:5173      (para el link del mail de "olvidé mi contraseña")
# PERMITIR_REGISTRO=true                  (false = solo el admin crea usuarios)
# ADMIN_EMAIL=                            (este mail siempre es admin: útil si te bloqueás)
# SUPABASE_ANON_KEY=
